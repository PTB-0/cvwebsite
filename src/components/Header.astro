---
import { other, type Dict } from "../i18n";

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const nav = [
  { href: "#work", label: t.nav.work },
  { href: "#method", label: t.nav.method },
  { href: "#skills", label: t.nav.skills },
  { href: "#education", label: t.nav.education },
  { href: "#contact", label: t.nav.contact },
];
const alt = other(t.lang);
---

<header class="top">
  <a class="brand" href="#top">{t.name}</a>
  <nav aria-label={t.nav.label}>
    <a href="#top" aria-current="page">{t.nav.home}</a>
    {nav.map((item) => <a href={item.href}>{item.label}</a>)}
  </nav>
  <a class="lang" href={`/${alt}/`} lang={alt} hreflang={alt}>{t.switchLabel}</a>
</header>

<style>
  .top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 16px 24px;
  }
  .brand {
    font-size: 1.125rem;
    font-weight: 600;
    letter-spacing: -0.01em;
    text-decoration: none;
    color: var(--on-dusk);
  }
  .brand:hover {
    color: #fff;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 4px;
    padding: 6px;
    border-radius: 28px;
    background: rgba(11, 13, 20, 0.45);
    border: 1px solid var(--glass-edge);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  nav a {
    display: inline-flex;
    align-items: center;
    min-height: 40px;
    padding: 0 16px;
    border-radius: 999px;
    font-size: 0.9375rem;
    color: rgba(244, 246, 251, 0.92);
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }
  nav a:hover {
    background: var(--glass-strong);
    color: #fff;
  }
  nav a[aria-current="page"] {
    background: rgba(255, 255, 255, 0.18);
    color: #fff;
  }
  .lang {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 44px;
    min-height: 40px;
    padding: 0 14px;
    border-radius: 999px;
    font-size: 0.875rem;
    color: var(--on-dusk);
    text-decoration: none;
    background: rgba(11, 13, 20, 0.45);
    border: 1px solid var(--glass-edge);
    transition: background-color 150ms ease;
  }
  .lang:hover {
    background: var(--glass-strong);
    color: #fff;
  }
  @media (max-width: 760px) {
    nav {
      order: 3;
      width: 100%;
    }
  }
</style>
