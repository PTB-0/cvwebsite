---
import { getCollection } from "astro:content";
import Project from "./Project.astro";
import SectionHead from "./SectionHead.astro";
import type { Dict } from "../i18n";

interface Props {
  t: Dict;
}

const { t } = Astro.props;
const projects = (await getCollection("projects")).sort((a, b) => a.data.order - b.data.order);
---

<section class="section work" id="work" aria-labelledby="work-title">
  <div class="inner">
    <SectionHead id="work-title" title={t.work.title} intro={t.work.intro} />
    <div class="list">
      {projects.map((project, i) => <Project project={project} figure={i + 1} t={t} />)}
    </div>
  </div>
</section>

<style>
  .work {
    background:
      radial-gradient(900px 720px at 100% 12%, rgba(79, 140, 255, 0.14), transparent 70%),
      radial-gradient(900px 720px at 0% 68%, rgba(80, 96, 230, 0.13), transparent 70%);
  }
  .section-head {
    margin-bottom: 64px;
  }
  .list {
    display: flex;
    flex-direction: column;
    gap: 96px;
  }
</style>
