---
import Header from "./Header.astro";
import type { Dict } from "../i18n";

interface Props {
  t: Dict;
}

const { t } = Astro.props;
---

<div class="hero" id="top">
  <div class="atmos" aria-hidden="true">
    <i class="figure"></i>
    <i class="figure-glow"></i>
    <i class="coral"></i>
    <i class="pink"></i>
    <i class="amber"></i>
    <i class="blue"></i>
    <i class="shade"></i>
    <i class="reeds"></i>
  </div>

  <Header t={t} />

  <section class="body" aria-labelledby="hero-title">
    <div class="copy">
      <h1 id="hero-title">{t.hero.title}</h1>
      <p class="lede">{t.hero.lede}</p>
      <div class="actions">
        <a class="btn" href="#work">{t.hero.primary}</a>
        <a class="ghost" href={t.hero.githubHref}>{t.hero.github}</a>
      </div>
    </div>

    <aside class="now" aria-labelledby="now-title">
      <div class="now-head">
        <h2 id="now-title">{t.hero.nowTitle}</h2>
        <span class="mono">{t.hero.nowDate}</span>
      </div>
      {
        t.hero.now.map((item) => (
          <div class="card">
            <span class="mono">{item.label}</span>
            <span class="val">{item.value}</span>
            {item.note && <span class="note">{item.note}</span>}
          </div>
        ))
      }
    </aside>
  </section>

  <ul class="facts">
    {
      t.hero.facts.map((f) => (
        <li>
          <span class="label">{f.label}</span>
          <span class="value">{f.value}</span>
        </li>
      ))
    }
  </ul>
</div>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    min-height: clamp(720px, 100svh, 960px);
    padding: 28px var(--gutter) 36px;
    color: var(--on-dusk);
    background: linear-gradient(180deg, var(--bg) 0%, var(--night-1) 65%, var(--night-2) 100%);
  }

  /* Atmosphere: static layers only. Radial gradients are already soft, so only the figure is blurred. */
  .atmos {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
  }
  .atmos i {
    position: absolute;
    display: block;
  }
  .figure {
    left: 42%;
    top: 6%;
    width: 300px;
    height: 96%;
    border-radius: 150px;
    background: linear-gradient(
      180deg,
      rgba(150, 190, 255, 0) 0%,
      rgba(150, 190, 255, 0.85) 22%,
      rgba(79, 140, 255, 0.8) 62%,
      rgba(30, 50, 160, 0) 100%
    );
    filter: blur(56px);
  }
  .figure-glow {
    left: 51%;
    top: 27%;
    width: 380px;
    height: 280px;
    background: radial-gradient(closest-side, rgba(255, 150, 190, 0.8), rgba(255, 150, 190, 0));
  }
  .coral {
    left: -220px;
    bottom: -280px;
    width: 960px;
    height: 720px;
    background: radial-gradient(closest-side, rgba(255, 122, 89, 0.8), rgba(255, 122, 89, 0));
  }
  .pink {
    right: -140px;
    bottom: -220px;
    width: 860px;
    height: 640px;
    background: radial-gradient(closest-side, rgba(255, 95, 162, 0.65), rgba(255, 95, 162, 0));
  }
  .amber {
    left: 30%;
    bottom: -140px;
    width: 560px;
    height: 380px;
    background: radial-gradient(closest-side, rgba(255, 179, 107, 0.75), rgba(255, 179, 107, 0));
  }
  .blue {
    left: -200px;
    top: -260px;
    width: 900px;
    height: 640px;
    background: radial-gradient(closest-side, rgba(79, 140, 255, 0.5), rgba(79, 140, 255, 0));
  }
  .shade {
    inset: 0;
    background: linear-gradient(90deg, rgba(11, 13, 20, 0.6) 0%, rgba(11, 13, 20, 0) 58%);
  }
  .reeds {
    inset: 0;
    background: repeating-linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.1) 0px,
      rgba(255, 255, 255, 0) 4px,
      rgba(0, 0, 0, 0.16) 7px,
      rgba(0, 0, 0, 0) 12px
    );
  }

  .body {
    margin-top: auto;
    padding-top: 72px;
  }
  .copy {
    display: flex;
    flex-direction: column;
    gap: 28px;
    max-width: 780px;
  }
  h1 {
    font-family: var(--serif);
    font-weight: 400;
    font-size: clamp(3.25rem, 1.5rem + 6vw, 6.75rem);
    line-height: 1.06;
    letter-spacing: -0.02em;
    text-wrap: balance;
  }
  .lede {
    max-width: 52ch;
    font-size: 1.125rem;
    line-height: 1.6;
    color: rgba(244, 246, 251, 0.88);
    text-wrap: pretty;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px 16px;
  }
  .btn,
  .ghost {
    display: inline-flex;
    align-items: center;
    min-height: 48px;
    padding: 0 28px;
    border-radius: 999px;
    font-size: 0.9375rem;
    text-decoration: none;
    transition: background-color 150ms ease, color 150ms ease;
  }
  .btn {
    background: var(--on-dusk);
    color: var(--bg);
    font-weight: 500;
  }
  .btn:hover {
    background: #fff;
    color: var(--bg);
  }
  .ghost {
    padding: 0 24px;
    color: #fff;
    background: var(--glass);
    border: 1px solid rgba(255, 255, 255, 0.26);
  }
  .ghost:hover {
    background: var(--glass-strong);
    color: #fff;
  }

  .now {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: min(100%, 420px);
    margin-top: 40px;
    padding: 20px;
    border-radius: 22px;
    background: var(--glass);
    border: 1px solid rgba(255, 255, 255, 0.24);
    backdrop-filter: blur(22px);
    -webkit-backdrop-filter: blur(22px);
  }
  .now-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0 4px 4px;
  }
  .now h2 {
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .now .mono {
    color: rgba(244, 246, 251, 0.78);
  }
  .card {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 16px;
    border-radius: 14px;
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.18);
  }
  .val {
    font-size: 1.0625rem;
    font-weight: 500;
    line-height: 1.3;
  }
  .note {
    font-size: 0.8125rem;
    color: rgba(244, 246, 251, 0.82);
  }
  @media (min-width: 1180px) {
    .now {
      position: absolute;
      right: var(--gutter);
      top: 112px;
      width: 380px;
      margin-top: 0;
    }
  }

  .facts {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 32px;
    margin-top: 48px;
  }
  .facts li {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-top: 14px;
    border-top: 1px solid rgba(255, 255, 255, 0.32);
  }
  .label {
    font-size: 0.8125rem;
    color: rgba(244, 246, 251, 0.78);
  }
  .value {
    font-size: 0.9375rem;
    font-weight: 500;
    line-height: 1.4;
  }
  @media (max-width: 900px) {
    .facts {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 24px;
    }
  }
  @media (max-width: 520px) {
    .facts {
      grid-template-columns: minmax(0, 1fr);
    }
    .figure {
      left: 30%;
    }
  }
</style>
